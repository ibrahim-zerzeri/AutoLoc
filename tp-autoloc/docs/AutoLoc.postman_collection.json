	"item": [
		{
			"name": "0. Documentation & Swagger",
			"item": [
				{
					"name": "OpenAPI Documentation (JSON)",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/v3/api-docs"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200 - OpenAPI spec\", () => pm.response.to.have.status(200));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Swagger UI HTML",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/swagger-ui.html"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200 ou 302 - Swagger UI\", () => {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},

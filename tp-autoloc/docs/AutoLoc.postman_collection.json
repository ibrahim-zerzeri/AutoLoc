{
	"info": {
		"name": "AutoLoc API",
		"description": "Collection Postman complète pour l'Atelier 5 (Contrats, Paiements, Agences, Clients, Véhicules, Employés, Équipements, Réservations, Maintenances)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Contrats",
			"item": [
				{
					"name": "Lister les contrats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Consulter un contrat inexistant",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/contrats/9999",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "9999"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 404\", () => pm.response.to.have.status(404));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Créer un contrat",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 480.00,\n  \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
									"var data = pm.response.json();",
									"pm.environment.set(\"contratId\", data.idContrat || data.id);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Créer un contrat avec un identifiant (400)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": 5,\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 480.00,\n  \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 400\", () => pm.response.to.have.status(400));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Créer un contrat avec ses paiements (Cascade)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 480.00,\n  \"valide\": true,\n  \"paiements\": [\n    { \"montant\": 150.00, \"datePaiement\": \"2026-11-02\", \"modePaiement\": \"CARTE\" },\n    { \"montant\": 330.00, \"datePaiement\": \"2026-11-06\", \"modePaiement\": \"VIREMENT\" }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
									"var data = pm.response.json();",
									"pm.environment.set(\"contratCascadeId\", data.idContrat || data.id);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Modifier un contrat (PUT)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 520.00,\n  \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats/{{contratId}}",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "{{contratId}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Montant modifié\", () => pm.expect(pm.response.json().montantTotal).to.eql(520.00));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Modifier contrat montant négatif (400)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"montantTotal\": -100.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats/{{contratId}}",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "{{contratId}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 400\", () => pm.response.to.have.status(400));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Supprimer un contrat (DELETE)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/contrats/{{contratId}}",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "{{contratId}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 204\", () => pm.response.to.have.status(204));"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
